{
  "name": "tauri-app",
  "private": true,
  "version": "2.3.19",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:agent": "vitest run src/__tests__/modelProfile.test.ts src/__tests__/harnessPhases.test.ts --reporter=dot",
    "test:agent:tools": "cargo test --manifest-path src-tauri/Cargo.toml --lib",
    "test:agent:recovery": "python tests/agent-upgrade/restart-recovery.py",
    "test:agent:live": "node tests/agent-upgrade/real-tool-smoke.mjs && node tests/agent-upgrade/real-summary-evidence.mjs",
    "test:agent:portable": "node tests/agent-upgrade/check-portable.mjs",
    "quality:core": "node tests/quality/run-quality.mjs core",
    "quality:full": "node tests/quality/run-quality.mjs full",
    "quality:live": "node tests/quality/run-quality.mjs live",
    "quality:report": "node tests/quality/run-quality.mjs report",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@ant-design/icons": "^6.2.5",
    "@earendil-works/pi-agent-core": "0.84.4",
    "@earendil-works/pi-ai": "0.84.4",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-opener": "^2.5.0",
    "@tauri-apps/plugin-sql": "^2.4.0",
    "@xyflow/react": "^12.3.5",
    "antd": "6.6.0",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "pdfjs-dist": "^6.2.108",
    "pptxgenjs": "^4.0.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "tesseract.js": "^7.0.0",
    "tslib": "^2.8.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.11.2",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.10",
    "ws": "^8.21.3"
  }
}
